# ArcBrief 前端（Next.js BFF）环境变量模板
# 本地开发：复制为 frontend/.env.local
# 生产(Vercel)：在 Vercel → Settings → Environment Variables 填入
#
# 注意：不带 NEXT_PUBLIC_ 前缀的变量只在服务端可用（浏览器看不到）。
# ⚠️ 值和注释不能放同一行！dotenv 会把 # 后面的文字当作值的一部分。

# ── BFF 代理配置（服务端，浏览器不可见）────────────
# 后端地址（生产改为 Railway URL）
ARCBRIEF_PROXY_API_BASE=http://localhost:8000/api
# = 后端 ARCBRIEF_PUBLIC_API_KEY（访客 key，用于 POST /run、/chat）
ARCBRIEF_PROXY_API_KEY=
# = 后端 ARCBRIEF_API_KEY（管理员 key）；填写后 BFF 放行管理路由；公开演示留空
ARCBRIEF_PROXY_ADMIN_KEY=
# = 后端同名变量（IP 签名密钥）；本地留空；生产必填
ARCBRIEF_PROXY_SIGNING_SECRET=
# =1 代理层进入只读演示：仅放行浏览类 GET，拒绝所有写操作，并忽略 ARCBRIEF_PROXY_ADMIN_KEY
ARCBRIEF_PUBLIC_READ_ONLY=0
# =1 无后端静态演示：直接读取 demo-data/snapshot.json，PDF 指向 public/demo/pdfs
# 生成：python scripts/build_demo_snapshot.py + npm run demo:pdfs
ARCBRIEF_STATIC_DEMO=0

# ── 前端 UI 开关（NEXT_PUBLIC_ = 会打包进浏览器 JS）─
# =1 只读演示：隐藏研究/生成/编辑入口并显示只读提示；需与上面两个只读开关一起使用
NEXT_PUBLIC_ARCBRIEF_READ_ONLY=0
# =0 隐藏所有管理按钮（公开演示用）；不设置或 =1 则显示
# NEXT_PUBLIC_ARCBRIEF_ENABLE_ADMIN_ACTIONS=0
# =1 显示开发者面板（Runtime Diagnostics 等）
# NEXT_PUBLIC_SHOW_DEV_PANELS=0
