# ArcBrief environment template
# This file is intentionally concise. Fill values and copy to .env.

# ============================================================
# 1) Local minimal defaults (dev / quick start)
# ============================================================
# LLM (OpenAI-compatible)
FQ_LLM_API_KEY=
FQ_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FQ_LLM_MODEL=qwen3-max

# API/security
ARCBRIEF_API_KEY=replace-with-your-key
ARCBRIEF_DISABLE_AUTH=0
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60
MAX_CONCURRENT_RESEARCH=3

# Database (local)
ARCBRIEF_DB_PATH=arcbrief.db

# Scheduler / brief behavior
ARCBRIEF_SCHED_TZ=America/Toronto
ARCBRIEF_NEWS_MAX_AGE_HOURS=24
ARCBRIEF_BRIEF_SAME_DAY_ONLY=1
ARCBRIEF_BRIEF_ALLOW_CROSS_DAY_FALLBACK=1

# RSS strategy (locked by current decision: RSS-only)
ARCBRIEF_ENABLE_TAVILY=0
ARCBRIEF_RSS_ONLY=1
TAVILY_API_KEY=

# Optional Discord integration
DISCORD_WEBHOOK_URL=
DISCORD_TOKEN=
# Per-topic webhook overrides (optional)
# DISCORD_WEBHOOK_TOPIC_3=
# DISCORD_WEBHOOK_TOPIC_7=

# ============================================================
# 2) Railway required overrides (production)
# ============================================================
# Set these in Railway Variables (not in git-tracked files):
ARCBRIEF_API_KEY=<strong-random-key>
ARCBRIEF_DISABLE_AUTH=0
ALLOWED_ORIGINS=https://<your-vercel-domain>
ARCBRIEF_DB_PATH=/data/arcbrief.db
ARCBRIEF_SCHED_TZ=Asia/Shanghai
ARCBRIEF_ENABLE_TAVILY=0
ARCBRIEF_RSS_ONLY=1
DISCORD_WEBHOOK_URL=<webhook-url> or DISCORD_WEBHOOK_TOPIC_<id>=<webhook-url>
DISCORD_TOKEN=<only-if-you-deploy-discord-bot>

# ============================================================
# 3) Optional advanced controls (leave as default if unsure)
# ============================================================
FQ_MAX_REFLECTIONS=3
FQ_MAX_PARAGRAPHS=4
FQ_MAX_RESULTS=8
FQ_OUTPUT_DIR=outputs
FQ_MOCK=0

ARCBRIEF_ALLOW_UNDATED=0
ARCBRIEF_RSS_REQUIRE_PUBLISHED=1
ARCBRIEF_MIN_RSS_ITEMS_BEFORE_TAVILY=12
ARCBRIEF_MIN_TITLE_LEN=12
ARCBRIEF_MIN_CONTENT_LEN=40
ARCBRIEF_MIN_URL_PATH_DEPTH=1

ARCBRIEF_ENABLE_KEYWORD_MATRIX=1
ARCBRIEF_KEYWORD_MIN_SCORE=1
ARCBRIEF_ARXIV_MIN_SCORE=2
ARCBRIEF_ARXIV_MAX_ITEMS=3
ARCBRIEF_RECENCY_HALFLIFE_HOURS=12   # Freshness half-life in hours (score=0.5 at this age)

DISCORD_TEST_CHANNEL_ID=
