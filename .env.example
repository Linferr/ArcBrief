# ArcBrief backend environment template
# Copy this file to .env and fill actual values.
# Keep comments and values on separate lines to avoid dotenv parsing surprises.

# LLM (OpenAI-compatible)
FQ_LLM_API_KEY=
FQ_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FQ_LLM_MODEL=qwen3-max

# API auth
ARCBRIEF_API_KEY=replace-with-your-key
ARCBRIEF_PUBLIC_API_KEY=replace-with-public-key
ARCBRIEF_DISABLE_AUTH=0
# =1 blocks guest /run and /chat, and publicly exposes read-only history/report endpoints.
# Only enable on a hosted demo whose stored briefs and reports are safe to publish.
ARCBRIEF_PUBLIC_DEMO_READ_ONLY=0
ALLOWED_ORIGINS=http://localhost:3000

# Rate limits
RATE_LIMIT_PER_MIN=60
ARCBRIEF_PUBLIC_RATE_LIMIT_PER_MIN=15
ARCBRIEF_PUBLIC_READ_RATE_LIMIT_PER_MIN=60
ARCBRIEF_PUBLIC_EXPORT_RATE_LIMIT_PER_MIN=10
ARCBRIEF_ROUTE_LIMIT_RUN_PER_MIN=4
ARCBRIEF_ROUTE_LIMIT_CHAT_PER_MIN=8
ARCBRIEF_ADMIN_ROUTE_LIMIT_MULTIPLIER=10
ARCBRIEF_RATE_LIMIT_STORAGE_URI=
MAX_CONCURRENT_RESEARCH=3
MAX_CONCURRENT_CHAT=10

# Reverse proxy / signed client IP
FORWARDED_ALLOW_IPS=127.0.0.1
ARCBRIEF_PROXY_SIGNING_SECRET=
ARCBRIEF_PROXY_SIGNED_IP_MAX_AGE_SECONDS=60

# Database
ARCBRIEF_DB_PATH=arcbrief.db

# Scheduler / brief behavior
ARCBRIEF_SCHED_TZ=America/Toronto
ARCBRIEF_NEWS_MAX_AGE_HOURS=24
ARCBRIEF_BRIEF_SAME_DAY_ONLY=1
ARCBRIEF_BRIEF_ALLOW_CROSS_DAY_FALLBACK=1

# RSS policy (single switch)
# ARCBRIEF_RSS_ONLY=1 -> RSS only
# ARCBRIEF_RSS_ONLY=0 -> allow Tavily supplement when TAVILY_API_KEY is set
ARCBRIEF_RSS_ONLY=1
TAVILY_API_KEY=

# Research search provider defaults
# If app config does not override it, this value is used.
ARCBRIEF_SEARCH_PROVIDER=Tavily Search API
ARCBRIEF_RESEARCH_STRICT_PROVIDER=1
BOCHA_API_KEY=
ZHIPU_API_KEY=
ZHIPU_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_WEB_SEARCH_MODEL=glm-4-plus
EXA_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL_EP=

# Research runtime
FQ_MAX_REFLECTIONS=3
FQ_MAX_PARAGRAPHS=4
FQ_MAX_RESULTS=8
FQ_OUTPUT_DIR=outputs
FQ_MOCK=0

# Collection filtering and scoring
ARCBRIEF_ALLOW_UNDATED=0
ARCBRIEF_RSS_REQUIRE_PUBLISHED=1
ARCBRIEF_MIN_RSS_ITEMS_BEFORE_TAVILY=12
ARCBRIEF_MIN_TITLE_LEN=12
ARCBRIEF_MIN_CONTENT_LEN=40
ARCBRIEF_MIN_URL_PATH_DEPTH=1
ARCBRIEF_ENABLE_KEYWORD_MATRIX=1
ARCBRIEF_KEYWORD_MIN_SCORE=1
ARCBRIEF_ARXIV_MIN_SCORE=2
ARCBRIEF_ARXIV_MAX_ITEMS=3
ARCBRIEF_RECENCY_HALFLIFE_HOURS=12
ARCBRIEF_TAVILY_ENRICH_EMPTY=1
ARCBRIEF_TAVILY_ENRICH_MAX_ITEMS=12

# In-memory run retention
ARCBRIEF_RUNS_TTL_HOURS=24
ARCBRIEF_RUNS_MAX_RECORDS=500

# Discord integrations
ARCBRIEF_API_BASE=http://localhost:8000/api
DISCORD_WEBHOOK_URL=
DISCORD_TOKEN=
DISCORD_ADMIN_IDS=
DISCORD_TEST_CHANNEL_ID=
# DISCORD_WEBHOOK_TOPIC_3=

# Frontend BFF variables (set in frontend/.env.local or Vercel)
ARCBRIEF_PROXY_API_BASE=http://localhost:8000/api
ARCBRIEF_PROXY_API_KEY=
ARCBRIEF_PROXY_ADMIN_KEY=
# Read-only public demo (set all three only when the stored data is safe to publish)
ARCBRIEF_PUBLIC_READ_ONLY=0
NEXT_PUBLIC_ARCBRIEF_READ_ONLY=0
NEXT_PUBLIC_ARCBRIEF_ENABLE_ADMIN_ACTIONS=0
