# ArcBrief Environment Variables
# Copy to .env and fill in your values

# ===========================
# LLM (OpenAI-compatible)
# ===========================
FQ_LLM_API_KEY=your_key
FQ_LLM_BASE_URL=https://api.example.com/v1
FQ_LLM_MODEL=gpt-4o-mini

# ===========================
# Search Tool (Tavily)
# ===========================
TAVILY_API_KEY=your_tavily_key
ARCBRIEF_ENABLE_TAVILY=1          # 0=disable, 1=enable Tavily search

# ===========================
# Agent Runtime
# ===========================
FQ_MAX_REFLECTIONS=3              # Max reflection rounds for research agent
FQ_MAX_PARAGRAPHS=4               # Max paragraphs per research output
FQ_MAX_RESULTS=8                  # Max search results per query
FQ_OUTPUT_DIR=outputs             # Research output directory
FQ_MOCK=0                        # 1=mock mode (no real API calls)

# ===========================
# API & Security
# ===========================
ARCBRIEF_API_KEY=replace-with-your-key  # API authentication key
ALLOWED_ORIGINS=http://localhost:3000   # CORS allowed origins (comma-separated)
RATE_LIMIT_PER_MIN=60                  # Max API requests per minute
MAX_CONCURRENT_RESEARCH=3              # Max parallel research sessions
ARCBRIEF_DISABLE_AUTH=0                # 1=disable API auth (dev only)

# ===========================
# News Collection & Quality Gate
# ===========================
ARCBRIEF_NEWS_MAX_AGE_HOURS=48         # Only keep articles from last N hours
ARCBRIEF_BRIEF_SAME_DAY_ONLY=1         # 1=briefs use current-date articles only
ARCBRIEF_BRIEF_ALLOW_CROSS_DAY_FALLBACK=0  # 1=fallback to rolling window when same-day is empty
ARCBRIEF_SCHED_TZ=UTC                  # Scheduler timezone, e.g. Asia/Shanghai
ARCBRIEF_ALLOW_UNDATED=1               # 1=keep articles without publish date
ARCBRIEF_RSS_REQUIRE_PUBLISHED=1       # 1=require published date in RSS items
ARCBRIEF_RSS_ONLY=0                    # 1=RSS only, no Tavily fallback
ARCBRIEF_MIN_RSS_ITEMS_BEFORE_TAVILY=12  # Min RSS items before Tavily kicks in
ARCBRIEF_MIN_TITLE_LEN=12             # Discard articles with title < N chars
ARCBRIEF_MIN_CONTENT_LEN=40           # Discard articles with content < N chars
ARCBRIEF_MIN_URL_PATH_DEPTH=1         # Discard articles with URL path depth < N
ARCBRIEF_TAVILY_ENRICH_EMPTY=1        # 1=use Tavily to enrich low-signal RSS items
ARCBRIEF_TAVILY_ENRICH_MAX_ITEMS=12   # Max low-signal RSS items to enrich per topic

# ===========================
# Keyword Matrix
# ===========================
ARCBRIEF_ENABLE_KEYWORD_MATRIX=1       # 0=disable, 1=enable keyword filtering
ARCBRIEF_KEYWORD_MIN_SCORE=1           # Min keyword match score to keep article
ARCBRIEF_ARXIV_MIN_SCORE=2            # Min score for ArXiv articles (stricter)
ARCBRIEF_ARXIV_MAX_ITEMS=3            # Max ArXiv articles per collection

# ===========================
# Database
# ===========================
ARCBRIEF_DB_PATH=arcbrief.db          # SQLite database file path

# ===========================
# Discord Integration (optional)
# ===========================
DISCORD_TOKEN=                        # Bot token (for slash commands in discord_bot.py)
DISCORD_WEBHOOK_URL=                  # Global webhook URL for scheduled brief push
# Per-topic webhooks (override global, DISCORD_WEBHOOK_TOPIC_<id>):
# DISCORD_WEBHOOK_TOPIC_1=            # Topic 1 专用 webhook（Global Trending）
# DISCORD_WEBHOOK_TOPIC_3=            # Topic 3 专用 webhook（AI Daily）
DISCORD_TEST_CHANNEL_ID=              # Test channel ID (for e2e tests)
